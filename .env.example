APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://flashcards:flashcards@localhost:5432/flashcards?sslmode=disable
# Defaults to true in development, false in production.
AUTO_MIGRATE=true
LOG_LEVEL=debug
# Comma-separated browser origins (Expo web). Defaults to http://localhost:8081 in development.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Signs access tokens. Required in production: at least 32 characters (openssl rand -base64 48).
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Comma-separated Google OAuth client IDs (Android, iOS, web). Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=
# Requests per minute per IP on /v1/auth (0 disables).
AUTH_RATE_LIMIT=20
# How long each dictionary provider gets to answer.
DICTIONARY_TIMEOUT=3s
# Merriam-Webster Learner's Dictionary key (dictionaryapi.com). Empty: no fallback when Free Dictionary is down.
MW_LEARNERS_API_KEY=
